# Pharma Careers — environment variables
# Copy this file to `.env.local` (Vite) and fill in real values.
# NEVER commit `.env.local` or real secret values.

# ─────────────────────────────────────────────────────────────
# Supabase — data store
# The anon key is safe in the browser and is used for PUBLIC reads only.
# All writes (jobs, articles, site content, leads, …) go through server
# endpoints using the service role key, which bypasses RLS and exists only
# on the server.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Firebase Authentication — ADMIN only
# Client-side public config (safe to expose to the browser).
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only Firebase credentials (used by serverless / scripts).
# Preferred: full service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or: individual credentials
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
