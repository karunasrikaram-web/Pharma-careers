# ---------------------------------------------------------------------------
# Pharma Careers — environment configuration
# Copy this file to .env.local for local development.
# Never commit real secrets. Never expose APP_SECRET to the browser.
# ---------------------------------------------------------------------------

# Secret used to hash IP addresses for rate limiting and abuse prevention.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED in production. A development fallback is used when running `next dev`.
APP_SECRET=

# Absolute path or path relative to the project root for the SQLite database.
DATABASE_PATH=./data/pharma-careers.db

# Public site URL used for canonical URLs, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Only set this once the site owner has a real public contact address.
# Leave blank to avoid displaying an invented email address.
NEXT_PUBLIC_CONTACT_EMAIL=
