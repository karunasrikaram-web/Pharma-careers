# ---------------------------------------------------------------------------
# Pharma Careers — environment configuration
# Copy this file to .env.local for local development.
# Never commit real secrets. Never expose APP_SECRET to the browser.
# ---------------------------------------------------------------------------

# Secret used to hash IP addresses for rate limiting and abuse prevention.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED in production. A development fallback is used when running `next dev`.
APP_SECRET=

# ---------------------------------------------------------------------------
# Database
#
# Production (Vercel and any serverless host) should use a remote libSQL/Turso
# database. The deployment filesystem is read-only, so no database file or
# data directory is created there.
#
# Create a database with the Turso CLI, then copy the values below into your
# Vercel project environment variables:
#   turso db create pharma-careers
#   turso db show pharma-careers --url
#   turso db tokens create pharma-careers
#
# If these are left unset on a serverless host, the public site still loads in
# read-only demo mode from the committed db/fallback.db snapshot. Forms, job
# alerts and the admin area are disabled until Turso is configured.
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local development only. Ignored when TURSO_DATABASE_URL is set.
# This file is gitignored and is never deployed.
DATABASE_PATH=./data/pharma-careers.db

# Public site URL used for canonical URLs, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Only set this once the site owner has a real public contact address.
# Leave blank to avoid displaying an invented email address.
NEXT_PUBLIC_CONTACT_EMAIL=
